<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFramework>net10.0-android36</TargetFramework>
	  <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <AssemblyName>SLVZ.Billing.Myket</AssemblyName>

	  <Title>SLVZ Billing Myket</Title>
	  <Authors>Ashkan SLVZ</Authors>
	  <Company>SLVZ</Company>
	  <Description>A lightweight library for Android developers that make you able to purchase in app using Myket</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageTags>C#, Maui, Billing, Myket</PackageTags>

	  <Version>2.0.1</Version>
	  <AssemblyVersion>2.0.1</AssemblyVersion>
	  <FileVersion>2.0.1</FileVersion>

  </PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Build\SLVZ.Billing.Myket.targets" Pack="true" PackagePath="build\" />
	</ItemGroup>

	<ItemGroup>
		<AndroidMavenLibrary Include="com.github.myketstore:myket-billing-client" Version="1.19" Repository="https://jitpack.io" />
	</ItemGroup>

	<ItemGroup>
		<AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-android-extensions-runtime" Version="1.7.21" Bind="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" PrivateAssets="all"/>
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.1"  PrivateAssets="all"/>
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" PrivateAssets="all" />
		<PackageReference Include="Xamarin.GooglePlayServices.Ads.Identifier" Version="118.3.0.3" PrivateAssets="all" />
		<PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" PrivateAssets="all" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="2.4.0.1" PrivateAssets="all" />
		<PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.1.6" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Build\" />
	</ItemGroup>

</Project>