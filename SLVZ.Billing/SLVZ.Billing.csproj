<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android36</TargetFramework>
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>


		<IsTrimmable>true</IsTrimmable>

		<AssemblyTitle>SLVZ Billing</AssemblyTitle>
		<AssemblyName>SLVZ.Billing</AssemblyName>

		<Title>SLVZ Billing</Title>
		<Authors>Ashkan SLVZ</Authors>
		<Company>SLVZ</Company>
		<Description>A lightweight library for Android developers that make you able to purchase in app using Bazaar and Myket</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>C#, Maui, Billing, Cafebazaar, Myket, Googleplay</PackageTags>

		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<FileVersion>1.0.0</FileVersion>

	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />		   
	</ItemGroup>
</Project>