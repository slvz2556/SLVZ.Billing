<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFramework>net10.0-android36</TargetFramework>
	  <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <AssemblyName>SLVZ.Billing.Bazaar</AssemblyName>

	  <Title>SLVZ Billing Cafe Bazaar</Title>
	  <Authors>Ashkan SLVZ</Authors>
	  <Company>SLVZ</Company>
	  <Description>A lightweight library for Android developers that make you able to purchase in app using Cafe Bazaar</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageTags>C#, Maui, Billing, Cafebazaar</PackageTags>

	  <Version>2.0.0</Version>
	  <AssemblyVersion>2.0.0</AssemblyVersion>
	  <FileVersion>2.0.0</FileVersion>
  </PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>


	<ItemGroup>
		<AndroidMavenLibrary Include="com.github.cafebazaar.Poolakey:poolakey" Version="2.3.0" Repository="https://jitpack.io" />
	</ItemGroup>

	<ItemGroup>
		<AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-android-extensions-runtime" Version="1.7.21" Bind="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="2.4.0.1" />
	</ItemGroup>


</Project>